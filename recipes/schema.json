{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "type": "object",
  "required": ["title", "category", "steps"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "Name of the recipe"
    },
    "category": {
      "type": "string",
      "description": "Cuisine or category (e.g. Italian, Indian)"
    },
    "ingredients": {
      "description": "List of ingredients, or a map of section name to list",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "description": "Named sections (e.g. dough, topping), in display order",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      ]
    },
    "steps": {
      "description": "Ordered list of preparation steps, or a map of section name to list",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "description": "Named sections (e.g. dough, topping), in display order",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      ]
    },
    "notes": {
      "type": "array",
      "description": "Optional notes shown below the recipe (tips, dish size, servings)",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "description": "Where the recipe comes from, preferably a URL"
    },
    "images": {
      "type": "array",
      "description": "Optional list of image paths",
      "items": {
        "type": "string"
      }
    }
  }
}