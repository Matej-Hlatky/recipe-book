{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "type": "object",
  "required": ["title", "category", "steps"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "Name of the recipe"
    },
    "category": {
      "type": "string",
      "description": "Cuisine or category (e.g. Italian, Indian)"
    },
    "ingredients": {
      "type": "array",
      "description": "List of ingredients",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "description": "Ordered list of preparation steps",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "images": {
      "type": "array",
      "description": "Optional list of image paths",
      "items": {
        "type": "string"
      }
    }
  }
}